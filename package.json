{
  "name": "getta",
  "description": "An isomorphic rest client based on the Fetch API.",
  "version": "1.0.22-unstable-12345.8",
  "author": "miami-man",
  "license": "MIT",
  "homepage": "https://github.com/badbatch/getta",
  "repository": "badbatch/getta",
  "bugs": "https://github.com/badbatch/getta/issues",
  "type": "module",
  "bin": {
    "getta": "./bin/getta.mjs"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/cjs/index.d.cts",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    "source": "./src/index.ts",
    ".": {
      "types": {
        "import": "./dist/types/esm/index.d.ts",
        "require": "./dist/types/cjs/index.d.cts"
      },
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    },
    "./cli": {
      "types": {
        "import": "./dist/types/esm/cli.d.ts",
        "require": "./dist/types/cjs/cli.d.cts"
      },
      "import": "./dist/esm/cli.mjs",
      "require": "./dist/cjs/cli.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run clean:dist && pnpm run compile",
    "clean:deps": "del-cli ./node_modules",
    "clean:dist": "del-cli ./dist",
    "compile": "pnpm run /^compile:.*/",
    "compile:cjs": "MODULE_SYSTEM=cjs rollup -c ./rollup.config.mjs",
    "compile:esm": "rollup -c ./rollup.config.mjs",
    "compile:types": "tsc --project ./tsconfig.build.json && cts-types build dist/types/esm dist/types/cjs",
    "coverage-generate": "nyc report --reporter=lcov -t coverage --report-dir coverage",
    "coverage-open": "open-cli ./coverage/lcov-report/index.html",
    "cut:changelog": "changelog",
    "format": "prettier . --check",
    "installActivateMise": "sh shellScripts/installActivateMise.sh",
    "jest": "COMPILER=swc node --require=suppress-experimental-warnings --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests",
    "lint": "pnpm run /^lint:.*/",
    "lint:code": "eslint .",
    "lint:docs": "markdownlint-cli2 --config \".markdownlint.json\" \"**/*.md\" \"!**/node_modules/**\"",
    "prepare": "husky",
    "repodog": "repodog",
    "syncpack": "syncpack format --check && syncpack lint",
    "test": "del-cli ./coverage && pnpm run jest && pnpm run coverage-generate",
    "type-check": "tsc --noEmit",
    "validate": "pnpm run syncpack && pnpm run build && pnpm run lint && pnpm run format && pnpm run type-check && pnpm run test"
  },
  "dependencies": {
    "@types/lodash-es": "^4.17.12",
    "cacheability": "^4.0.38",
    "core-js": "^3.51.0",
    "js-yaml": "^5.5.0",
    "lodash-es": "^4.18.1",
    "query-string": "^10.0.0",
    "type-fest": "^5.10.0",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@cachemap/core": "^5.3.3-unstable-12345.4",
    "@commitlint/cli": "^21.2.4",
    "@jest/globals": "^30.5.2",
    "@repodog/cli": "^1.7.10",
    "@repodog/commitlint-config": "^21.0.4",
    "@repodog/eslint-config": "^9.0.37",
    "@repodog/eslint-config-jest": "^9.0.12",
    "@repodog/jest-config": "^30.0.8",
    "@repodog/markdownlint-config": "^1.2.8",
    "@repodog/prettier-config": "^3.0.8",
    "@repodog/rollup-config": "^4.0.20",
    "@repodog/swc-config": "^1.0.17",
    "@repodog/syncpack-config": "^15.0.7",
    "@repodog/ts-config": "^6.0.5",
    "@rollup/plugin-swc": "^0.4.1",
    "@swc/core": "^1.16.21",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/yargs": "^17.0.35",
    "cts-types": "^0.0.17",
    "del-cli": "^8.0.1",
    "eslint": "^10.14.0",
    "fetch-mocked": "^0.0.39",
    "generate-changelog": "^1.8.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-node": "^30.5.2",
    "markdownlint-cli2": "^0.24.0",
    "nyc": "^18.0.0",
    "open-cli": "^9.0.0",
    "prettier": "^3.9.10",
    "rollup": "^4.67.5",
    "suppress-experimental-warnings": "^2.0.0",
    "syncpack": "^15.3.3",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  },
  "keywords": [
    "api-client",
    "fetch",
    "isomorphic",
    "rest"
  ]
}
